PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/vaybeex

# JWT
JWT_SECRET=change-this-to-a-long-random-string
# Traveler sessions (booking convenience)
JWT_EXPIRES_IN=7d
# Organizer sessions (shorter for safety)
JWT_ORGANIZER_EXPIRES_IN=12h
# Admin sessions (shortest)
JWT_ADMIN_EXPIRES_IN=8h

# OTP
OTP_SECRET=change-this-otp-pepper-string
OTP_EXPIRY_MINUTES=10

# Google Sign-In (traveler) — OAuth 2.0 Client IDs from Google Cloud Console
# Use the Web client ID at minimum. Add iOS/Android IDs if those apps sign in too.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Or comma-separated list (optional alternative to the vars above):
# GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com

# Arkesel SMS (https://arkesel.com)
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=VaybeEx
ARKESEL_SANDBOX=false
# Organizer SMS broadcasts
SMS_COST_PER_SEGMENT_GHS=0.05
SMS_BROADCAST_MAX_RECIPIENTS=200

# Email via Resend (https://resend.com)
# Use a verified domain in production, e.g. VaybeEx <noreply@vaybeex.com>
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=VaybeEx <noreply@vaybeex.com>

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/booking/callback
APP_BASE_URL=http://localhost:3000
# Public backend URL for absolute media links in emails (cover images)
# API_PUBLIC_URL=https://api.vaybeex.com

# Enable Transfers in Paystack Dashboard and fund your Paystack balance
# for automatic organizer MoMo withdrawals (GHS).
# Refunds also debit the same Paystack balance back to the traveler's
# original payment method when an organizer approves a cancellation.
